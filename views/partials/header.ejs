<!DOCTYPE HTML>
<html lang="hu">
<head>
    <title>Cukrászda – Édes pillanatok</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <link rel="stylesheet" href="/assets/css/main.css">
    <noscript>
        <link rel="stylesheet" href="/assets/css/noscript.css">
    </noscript>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="is-preload">
<div id="wrapper" class="fade-in">

    <div id="intro">
        <h1>Édes pillanatok<br>Cukrászda</h1>
        <p>Friss sütemények, különleges torták és felejthetetlen ízek.</p>
        <ul class="actions">
            <li>
                <a href="#header" class="button icon solid solo fa-arrow-down scrolly">
                    Tovább
                </a>
            </li>
        </ul>
    </div>
    <header id="header">
        <a href="/" class="logo">Édes pillanatok</a>
    </header>
    <nav id="nav">
        <ul class="links">
            <li><a href="/">Főoldal</a></li>
            <li><a href="/adatbazis">Süteményeink</a></li>
            <li><a href="/kapcsolat">Kapcsolat</a></li>
            <li><a href="/diagram">Diagram</a></li>
            <% if (user) { %>
                <li><a href="/uzenetek">Üzenetek</a></li>
                <% if (user.role === "admin") { %>
                    <li><a href="/admin">Admin</a></li>
                    <li><a href="/crudindex">CRUD</a></li>
                <% } else { %>
                    <li><a href="/user">Profil</a></li>
                <% } %>
                <li><a href="/logout">Kijelentkezés</a></li>
            <% } else { %>
                <li><a href="/login">Bejelentkezés</a></li>
                <li><a href="/register">Regisztráció</a></li>
            <% } %>
        </ul>
    </nav>
    <div id="main">